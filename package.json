{
  "name": "employee-activity-management",
  "version": "1.0.0",
  "description": "Employee Activity Management Tool",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd client && npm run dev",
    "dev:full": "concurrently \"npm run dev\" \"npm run client\"",
    "build": "cd client && npm run build",
    "build:full": "npm run build && npm run start",
    "ci:backend": "node scripts/check_backend_syntax.js",
    "prestart": "npm run build",
    "db:seed:safe": "node scripts/apply_safe_schema_seed_patch.js",
    "db:migrate:school-curriculum": "node scripts/applySchoolCurriculumMigration.js",
    "db:migrate:school-timetable": "node scripts/applyTrainerSchoolTimetableMigration.js",
    "db:migrate:school-activity-outcomes": "node scripts/applySchoolActivityOutcomesMigration.js",
    "db:migrate:trainer-leaderboard": "node scripts/applyTrainerLeaderboardMigration.js",
    "db:migrate:school-activity-mail": "node scripts/applySchoolActivityMailMigration.js",
    "db:migrate:school-activity-evidence": "node scripts/applySchoolActivityEvidenceMigration.js",
    "db:migrate:school-activity-cancelled": "node scripts/applySchoolActivityCancelledMigration.js",
    "db:migrate:school-curriculum-overrides": "node scripts/applySchoolCurriculumOverridesMigration.js",
    "db:migrate:common-courses": "node scripts/applyCommonCoursesMigration.js",
    "db:migrate:school-management": "node scripts/applySchoolManagementMigration.js",
    "school-classes:sync": "node scripts/syncSchoolClassesFromTimesheet.js",
    "curriculum:import": "node scripts/importSchoolCurriculum.js",
    "init:production": "node scripts/init_production_with_employees.js",
    "db:seed:pm": "node scripts/seed_pm_defaults.js",
    "db:setup:pm": "node scripts/seed_pm_defaults.js --sync",
    "production": "NODE_ENV=production npm start"
  },
  "dependencies": {
    "@mui/icons-material": "^7.1.1",
    "axios": "^1.13.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "react-icons": "^5.5.0",
    "react-tsparticles": "^2.12.2",
    "recharts": "^2.15.3",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7",
    "tsparticles": "^3.8.1",
    "validator": "^13.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.1",
    "nodemon": "^3.0.1"
  }
}
