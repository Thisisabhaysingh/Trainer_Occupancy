# Copy this to .env.production on the server and fill real values there.
NODE_ENV=production
PORT=5000

DB_DIALECT=mysql
DB_HOST=your-rds-host.amazonaws.com
DB_PORT=3306
DB_NAME=mis_database
DB_USER=dbmasteruser
DB_PASSWORD=change-me

JWT_SECRET=change-this-long-secret
SESSION_SECRET=change-this-long-secret

CORS_ORIGIN=https://time.onmyowntechnology.com
FRONTEND_URL=https://time.onmyowntechnology.com

AUTO_SCHEMA_SEED=true
AUTO_BASE_BACKUP_IMPORT=false
ENABLE_DB_SYNC=false
ALLOW_UNSAFE_DB_SYNC=false
PM_SEED_SYNC=false

EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM="OMOTEC MIS <your-gmail-address@gmail.com>"
