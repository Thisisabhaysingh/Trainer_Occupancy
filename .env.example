# Server Configuration
PORT=5001
NODE_ENV=production

# JWT & Session Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-change-this-in-production
SESSION_SECRET=your-super-secret-session-key-min-32-characters-long-change-this-in-production

# MySQL Database Configuration
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mis_database
DB_USER=root
DB_PASSWORD=your-mysql-password-here

# Docker Compose defaults
MYSQL_ROOT_PASSWORD=mis_root_password
MYSQL_DATABASE=mis_database
MYSQL_PORT=3307
BACKEND_PORT=5001
FRONTEND_PORT=8080

# Keep false. Startup schema changes should use AUTO_SCHEMA_SEED.
ENABLE_DB_SYNC=false

# Extra safety lock for sequelize.sync({ alter: true }). Keep false on server/production DBs.
ALLOW_UNSAFE_DB_SYNC=false

# Runs migrations/server_safe_schema_seed_patch.sql automatically on backend startup.
# Keep true/default for dev, Docker, and server deploys. Set false only if you want manual DB patching.
AUTO_SCHEMA_SEED=true

# If the target DB is empty, startup can import mis_database_backup.sql before applying the safe patch.
# Existing DBs are not imported over because the users table is checked first.
AUTO_BASE_BACKUP_IMPORT=true

# Optional for scripts/seed_pm_defaults.js. Use true only during controlled setup.
PM_SEED_SYNC=false

# CORS Configuration (Update with your domain in production)
CORS_ORIGIN=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Production Settings
LOG_LEVEL=info
TRUST_PROXY=1

# Gmail SMTP Email Notifications
# Use a Google App Password, not your normal Gmail password.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM="OMOTEC MIS <your-gmail-address@gmail.com>"
