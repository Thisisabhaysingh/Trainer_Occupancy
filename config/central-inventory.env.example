# Server-side only. Never expose these values through VITE_* variables.
CENTRAL_INVENTORY_ENABLED=false
CENTRAL_INVENTORY_READ_ONLY=true
CENTRAL_INVENTORY_BASE_URL=http://localhost:4000/v1/integrations/timesheet/inventory
CENTRAL_INVENTORY_CLIENT_ID=
CENTRAL_INVENTORY_CLIENT_SECRET=
CENTRAL_INVENTORY_TOKEN_URL=
# Legacy static JWT is supported only during migration.
CENTRAL_INVENTORY_JWT=
CENTRAL_INVENTORY_TIMEOUT_MS=15000
CENTRAL_INVENTORY_EXTERNAL_SYSTEM=mis

# Comma-separated CDN/storage hosts permitted for Central App item images.
# The CENTRAL_INVENTORY_BASE_URL host is always permitted automatically.
# Example: cdn.example.com,res.cloudinary.com
CENTRAL_INVENTORY_IMAGE_HOSTS=

# JSON map of MIS branch IDs to Central App branch IDs.
# Example: {"1":1,"5":2,"8":3}
CENTRAL_INVENTORY_BRANCH_MAP={}
